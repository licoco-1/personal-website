---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import NavBar from '../components/NavBar.astro';
import Hero from '../components/Hero.astro';
import ProfileBand from '../components/ProfileBand.astro';
import WorkCard from '../components/WorkCard.astro';
import { site } from '../data/site';

const works = (await getCollection('works')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const heroWorks = works.slice(0, site.heroCount);
---

<Base>
  <NavBar />

  <!-- 主视觉轮播 -->
  <Hero works={heroWorks} />

  <!-- 画师栏 -->
  <ProfileBand />

  <!-- 作品列表：响应式瀑布流 -->
  <main class="mx-auto w-full max-w-[1170px] px-4 py-16">
    <h2 class="section-heading">WORK</h2>
    <div class="mt-12 columns-1 gap-6 sm:columns-2 lg:columns-3">
      {works.map((work) => <WorkCard work={work} />)}
    </div>
  </main>
</Base>

---
import { site } from '../data/site';
import { withBase } from '../utils/url';
import LinkIcon from './LinkIcon.astro';
import Avatar from './Avatar.astro';

// 画师栏：主色通栏，圆形头像居左，简介、邮箱与社交按钮居右
---

<section class="bg-accent py-12 text-white">
  <div class="mx-auto w-full max-w-[1170px] px-4">
    <h2 class="section-heading text-white">PROFILE</h2>

    <div class="mt-9 flex flex-col gap-6 sm:flex-row sm:items-start">
      <Avatar class="size-28 shrink-0 rounded-full object-cover ring-4 ring-white/40" widths={[128, 256]} />
      <div class="min-w-0">
        <p class="text-lg font-bold tracking-wide">{site.artist}</p>
        <p class="mt-2 text-sm leading-relaxed text-white/90">
          {site.bio}
          <a href={withBase('/about/')} class="underline underline-offset-4 hover:text-white"> 了解更多 </a>
        </p>
        {
          site.email && (
            <p class="mt-1.5 text-sm text-white/90">
              ✉ <a href={`mailto:${site.email}`} class="underline underline-offset-4 hover:text-white">{site.email}</a>
            </p>
          )
        }
        {
          site.supportUrl && (
            <p class="mt-1.5 text-sm text-white/90">
              在
              <a href={site.supportUrl} target="_blank" rel="noopener" class="underline underline-offset-4 hover:text-white">赞助页</a>
              支持我的创作
            </p>
          )
        }
        <div class="mt-4 flex gap-3">
          {
            site.links.slice(0, 2).map((l) => (
              <a
                href={l.href}
                target="_blank"
                rel="noopener"
                aria-label={l.label}
                class="flex size-10 items-center justify-center rounded-full border border-white/70 transition hover:bg-white/15"
              >
                <LinkIcon name={l.icon} class="size-4" />
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

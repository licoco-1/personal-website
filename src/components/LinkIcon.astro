---
import type { LinkIcon } from '../data/site';

// 社交链接图标：按 name 输出对应的 SVG 图标
interface Props {
  name: LinkIcon;
  class?: string;
}
const { name, class: cls = 'size-5' } = Astro.props;
---

{
  name === 'x' && (
    <svg viewBox="0 0 24 24" fill="currentColor" class={cls} aria-label="X">
      <path d="M18.9 2H22l-6.8 7.8L23.2 22h-6.3l-4.9-6.4L6.4 22H3.2l7.3-8.3L2.8 2h6.4l4.4 5.9L18.9 2zm-1.1 18h1.7L7.1 3.9H5.3L17.8 20z" />
    </svg>
  )
}
{
  name === 'pixiv' && (
    <svg viewBox="0 0 24 24" fill="currentColor" class={cls} aria-label="pixiv">
      <path d="M9.6 7.1c-2.9 0-5.2 2.4-5.2 5.3s2.3 5.3 5.2 5.3c2.4 0 4.4-1.6 5-3.9h5.4v3.9h2.2V7.1h-2.2v4.2h-5.4c-.6-2.6-2.6-4.2-5-4.2zm-.1 2.2c1.7 0 3 1.4 3 3.1s-1.3 3.1-3 3.1-3-1.4-3-3.1 1.3-3.1 3-3.1z" />
      <path d="M1.5 7.1h2.2v10.7H1.5z" />
    </svg>
  )
}
{
  name === 'instagram' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class={cls} aria-label="Instagram">
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none" />
    </svg>
  )
}
{
  name === 'mail' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class={cls} aria-label="Email">
      <rect x="3" y="5" width="18" height="14" rx="3" />
      <path d="m4 7 8 6 8-6" />
    </svg>
  )
}
